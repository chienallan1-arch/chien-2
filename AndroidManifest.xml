<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.lineautorecorder">

    <!-- 嚴格不宣告 android.permission.INTERNET，確保 100% 離線不連網 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- 允許查詢小米內建錄音程式與 LINE 套件狀態 -->
    <queries>
        <package android:name="jp.naver.line.android" />
        <package android:name="com.android.soundrecorder" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="LINE 通話錄音"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 僅監聽 LINE 通話狀態與系統 Audio Mode，不讀取任何聊天文字 -->
        <service
            android:name=".LineCallMonitorService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>